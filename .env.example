# Copia a .env (git-ignored) o cárgalo en el secret ENV_VARS del entorno de GitHub.
# En despliegue el workflow inyecta REGISTRY/REPOSITORY/BRANCH/BUILD_ID/COMPOSE_PROJECT_NAME.
# No se publican puertos: el proxy principal (externo) enruta hacia los contenedores.

# --- Backend (turicine.catalogo) ---
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Host=postgres02.local;Port=5432;Database=TuricineXD40;Username=postgres;Password=change-me
CloudflareImages__AccountId=your-cloudflare-account-id
CloudflareImages__ApiToken=your-cloudflare-images-write-token
CloudflareImages__DeliveryBaseUrl=https://imagedelivery.net/<account-hash>
Keycloak__Authority=https://auth.lerolero.com.ec/realms/druk
Keycloak__Audience=turicine-catalog

# --- Panel (turicine.catalogo.panel) ---
# Vacío = mismo origen: nginx del panel proxya /api y /odata al servicio catalogo.
VITE_API_BASE_URL=
VITE_IMAGES_BASE_URL=https://imagedelivery.net/<account-hash>
VITE_KEYCLOAK_URL=https://auth.lerolero.com.ec
VITE_KEYCLOAK_REALM=druk
VITE_KEYCLOAK_CLIENT_ID=turicine-web
